<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>TrafficAIOptimizer</AssemblyName>
    <RootNamespace>TrafficAIOptimizer</RootNamespace>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Caminhos das DLLs do Cities: Skylines Sunset Harbor -->
  <PropertyGroup>
    <CitiesManagedDir Condition="'$(CitiesManagedDir)' == ''">$(MSBuildProjectDirectory)\..\..\Cities_Data\Managed</CitiesManagedDir>
    <TargetDeployDir Condition="'$(TargetDeployDir)' == ''">$(MSBuildProjectDirectory)\..\..\Files\Mods\TrafficAIOptimizer</TargetDeployDir>
  </PropertyGroup>

  <!-- Referências do Jogo Base -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(CitiesManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ICities">
      <HintPath>$(CitiesManagedDir)\ICities.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ColossalManaged">
      <HintPath>$(CitiesManagedDir)\ColossalManaged.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(CitiesManagedDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(CitiesManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.Networking">
      <HintPath>$(CitiesManagedDir)\UnityEngine.Networking.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- Deploy Automático após o Build -->
  <Target Name="DeployToGameMods" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true' and Exists('$(CitiesManagedDir)')">
    <Message Text="Copiando DLL compilada para $(TargetDeployDir)..." Importance="high" />
    <MakeDir Directories="$(TargetDeployDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(TargetDeployDir)" SkipUnchangedFiles="false" />
  </Target>

</Project>
