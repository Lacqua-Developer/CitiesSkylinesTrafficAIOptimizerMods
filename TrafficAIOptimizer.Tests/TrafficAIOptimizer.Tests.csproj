<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>7.3</LangVersion>
    <CitiesManagedDir Condition="'$(CitiesManagedDir)' == ''">$(MSBuildProjectDirectory)\..\..\Cities_Data\Managed</CitiesManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrafficAIOptimizer\TrafficAIOptimizer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(CitiesManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="ColossalManaged">
      <HintPath>$(CitiesManagedDir)\ColossalManaged.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="ICities">
      <HintPath>$(CitiesManagedDir)\ICities.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(CitiesManagedDir)\UnityEngine.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityEngine.Networking">
      <HintPath>$(CitiesManagedDir)\UnityEngine.Networking.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

</Project>
